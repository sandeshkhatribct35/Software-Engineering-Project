# Copy this file to .env for local development:  cp .env.example .env
# It documents every variable the application reads. It contains no real
# credentials — the values below describe a throwaway local database only.

# Application database (psycopg 3 driver).
DATABASE_URL=postgresql+psycopg://fairshare:fairshare@localhost:5432/fairshare

# Database used by the integration test suite. Must NOT be the application
# database: the suite truncates every table between tests.
TEST_DATABASE_URL=postgresql+psycopg://fairshare:fairshare@localhost:5432/fairshare_test

# Logging verbosity: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Set to true to echo generated SQL — useful when debugging queries locally.
ECHO_SQL=false
